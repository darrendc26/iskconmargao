# Site
SITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080

# Postgres
POSTGRES_DB=iskconmargao
POSTGRES_USER=iskcon
POSTGRES_PASSWORD=changeme
# Local `go run` uses localhost. Docker Compose overrides this to the postgres service.
DATABASE_URL=postgres://iskcon:changeme@localhost:5432/iskconmargao?sslmode=disable

# Auth
SESSION_SECRET=replace-with-64-char-random-secret
COOKIE_SECURE=false
COOKIE_DOMAIN=

# First admin (used by bootstrap / seed)
BOOTSTRAP_ADMIN_EMAIL=admin@margao.iskcongoa.com
BOOTSTRAP_ADMIN_PASSWORD=changeme-strong-password
BOOTSTRAP_ADMIN_NAME=Site Admin

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=iskcon-margao-media
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_REGION=auto

# Payments — Cashfree
PAYMENT_GATEWAY=cashfree
PAYMENT_MODE=redirect
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# Optional existing official donation page (redirect mode)
DONATION_EXTERNAL_URL=

# Email (replaceable provider)
EMAIL_PROVIDER=log
EMAIL_FROM=ISKCON Margao <noreply@margao.iskcongoa.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_NOTIFY_EMAIL=admin@margao.iskcongoa.com

# WhatsApp
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/replace-me
WHATSAPP_CONTACT_URL=https://wa.me/91XXXXXXXXXX

# Maps (also exposed to Next as NEXT_PUBLIC_MAPS_URL via next.config)
GOOGLE_MAPS_DIRECTIONS_URL=https://maps.google.com/?q=ISKCON+Margao+Matchless+Gifts
NEXT_PUBLIC_MAPS_URL=https://maps.google.com/?q=ISKCON+Margao+Matchless+Gifts

# Analytics
ANALYTICS_ENABLED=true
PLAUSIBLE_DOMAIN=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limits
RATE_LIMIT_CONTACT_PER_HOUR=8
RATE_LIMIT_LOGIN_PER_15M=8

# Backup (R2)
BACKUP_ENABLED=false
BACKUP_R2_PREFIX=backups/postgres
BACKUP_ENCRYPTION_KEY=

# Caddy / TLS
CADDY_EMAIL=admin@margao.iskcongoa.com
DOMAIN=margao.iskcongoa.com
